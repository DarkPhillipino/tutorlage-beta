// Cloudflare Workers config for the payments API (server/worker.ts). Master backlog item 1.
// Deploy: `npx wrangler deploy`. Secrets are never in this file; the CEO sets them once with
//   npx wrangler secret put PAYSTACK_SECRET_KEY
//   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
// The service-role key must belong to the project in SUPABASE_URL below.
// Closing accounts (21 Oct 2026) adds three more secrets, all set by 31 Oct 2026: CLOSE_ACCOUNT_JOB_SECRET (any long random value; the same
// value goes in the database's Vault as account_closure_job_secret), and RESEND_API_KEY + MAIL_FROM (so the closing emails can be sent).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutorlage-api",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Express 4 loads iconv-lite on start-up, and the real package crashes on Workers; see the shim's header.
  "alias": { "iconv-lite": "./server/shims/iconv-lite.cjs" },
  // Served only on its own workers.dev address, not under tutorlage.com: the domain is on Cloudflare's
  // free plan, and the agreement's 2.2.1(h) bars card information on anything receiving Free Services.
  "workers_dev": true,
  "vars": {
    // Production ("Tutorlage Production") since 31 Oct 2026, together with the site; dev is wfpjoxetbprmllqqarwp.
    // SUPABASE_SERVICE_ROLE_KEY must be the key of THIS project.
    "SUPABASE_URL": "https://qxzhqylrrspumvguflwj.supabase.co",
    // The site's own address, plus the old GitHub Pages address while it still redirects (28 Oct 2026).
    "ALLOWED_ORIGINS": "https://tutorlage.com,https://darkphillipino.github.io",
    // Cloudflare sets this header to the visitor's address; see rateLimit() in server/index.ts.
    "RATE_LIMIT_IP_HEADER": "cf-connecting-ip",
    // Video rooms (master 7bm), switched on 16 Oct 2026 (the CEO's "all seven, video rooms first"). Both are needed: without
    // VIDEO_RELAY_ONLY every room route answers 503 (fails closed). The relay's two secrets (CF_TURN_KEY_ID, CF_TURN_API_TOKEN)
    // are saved as Worker secrets. The database part is migration 20261009200000 (applied to dev 16 Oct).
    "VIDEO_ROOMS_ENABLED": "1",
    "VIDEO_RELAY_ONLY": "1",
    // Online top-ups, pay by bank (Ozow One API, REDIRECT checkout; phase 2 of 3, 9 Nov 2026). These two are plain variables. The five SECRETS are set by the CEO,
    // never written here: OZOW_CLIENT_ID, OZOW_CLIENT_SECRET, OZOW_SITE_CODE, OZOW_WEBHOOK_SECRET (all from Ozow) and WALLET_JOB_SECRET (any long random
    // value; the same value goes in the database's Vault as wallet_job_secret). Until all five exist the online routes answer "not set up".
    // OZOW_API_BASE: production below; Ozow's staging system (credentials on request) is https://stagingone.ozow.com/v1 and is the only place test payments are accepted.
    "OZOW_API_BASE": "https://one.ozow.com/v1",
    // Where the payer lands after Ozow: <this>/wallet/topup-return?topup=<id>. Ozow rejects localhost.
    "OZOW_RETURN_ORIGIN": "https://tutorlage.com",
    // Ozow PAYMENTS API (the older "classic" API; server/ozowPayments.ts; 17 Nov 2026): the second provider, chosen by the database setting wallet_online_provider = ozow_payments.
    // Its secrets are set by the CEO, never written here: OZOW_API_KEY and OZOW_PRIVATE_KEY (both from the Ozow dashboard, Merchant Details and Site) and OZOW_SITE_CODE (shared with the One API).
    // These two are plain variables. OZOW_PAYMENTS_BASE: https://api.ozow.com is production; https://stagingapi.ozow.com is Ozow's staging system (its own credentials, on request).
    // OZOW_PAYMENTS_TEST: "true" is a REHEARSAL (every request says isTest true: Ozow skips the bank, the payer picks a pretend outcome, and the database refuses to credit it). Leave it "false".
    // Ozow posts its notification to the Worker's own address (OZOW_NOTIFY_ORIGIN, which defaults to the workers.dev address in server/ozowPayments.ts; set it only if the Worker moves).
    "OZOW_PAYMENTS_BASE": "https://api.ozow.com",
    "OZOW_PAYMENTS_TEST": "false",
    // Web push for a request addressed to one tutor (24 Nov 2026; server/webPush.ts). The PUBLIC key is public by design. The PRIVATE half is the Worker secret VAPID_PRIVATE_KEY (set by the CEO, never in a repository),
    // and the shared secret PUSH_JOB_SECRET (same value as the Vault secret push_job_secret). Nothing is sent until the database setting web_push_enabled is switched on.
    "VAPID_PUBLIC_KEY": "BPH_nSrFYxI6WGtvohaSaW0ZaxfBf1_T0Fj0jk46e__19GjpB41AGyccBcWZFhgo0LXWH9JH2_4FCjr_H1KZfpc"
  },
  "observability": { "enabled": true },
  // Scheduled pulse (17 Nov 2026; server/pulseSchedule.ts): every 10 minutes the Worker checks the public site and mails when it breaks, once
  // an hour while it stays broken, and once when it is fine again (at most 24 mails a day: Resend's free plan allows 100 for the whole site).
  // It needs one more Worker secret, set by hand, NEVER written in this file or anywhere in the repository:
  //   npx wrangler secret put PULSE_ALERT_TO        (the address that gets the mail; without it nothing is mailed)
  // and a small Workers KV store for "was it fine last time" (binding PULSE_STATE; no id here: wrangler creates the store on the first deploy,
  // or run `npx wrangler kv namespace create PULSE_STATE` and put the id it prints in this binding). Without the store nothing is mailed.
  "triggers": { "crons": ["*/10 * * * *"] },
  "kv_namespaces": [{ "binding": "PULSE_STATE" }],
  // Shared rate limit (job P, 21 Nov 2026; server/rateLimit.ts and server/rateLimitCounter.ts): one Durable Object per visitor address + route
  // counts the calls for EVERY copy of the Worker, so the limit is real. SQLite-backed (new_sqlite_classes), which the free plan allows. If the
  // counter errors or is slow (over 400 ms) the request goes through on the old in-memory limit and a log line says so. Nothing to set by hand.
  "durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimitCounter" }] },
  "migrations": [{ "tag": "v1-rate-limit-counter", "new_sqlite_classes": ["RateLimitCounter"] }]
}
