// Cloudflare Workers config for the payments API (server/worker.ts). Master backlog item 1.
// Deploy: `npx wrangler deploy`. Secrets are never in this file; the CEO sets them once with
//   npx wrangler secret put PAYSTACK_SECRET_KEY
//   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
// The service-role key must belong to the project in SUPABASE_URL below.
// Closing accounts (21 Oct 2026) adds three more secrets, none of them set yet: CLOSE_ACCOUNT_JOB_SECRET (any long random value; the same
// value goes in the database's Vault as account_closure_job_secret), and RESEND_API_KEY + MAIL_FROM (so the closing emails can be sent).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutorlage-api",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Express 4 loads iconv-lite on start-up, and the real package crashes on Workers; see the shim's header.
  "alias": { "iconv-lite": "./server/shims/iconv-lite.cjs" },
  // Served only on its own workers.dev address, not under tutorlage.com: the domain is on Cloudflare's
  // free plan, and the agreement's 2.2.1(h) bars card information on anything receiving Free Services.
  "workers_dev": true,
  "vars": {
    // Dev for now: the public site and every test account use it. Switch with the site (master item 6).
    "SUPABASE_URL": "https://wfpjoxetbprmllqqarwp.supabase.co",
    // The site's own address, plus the old GitHub Pages address while it still redirects (28 Oct 2026).
    "ALLOWED_ORIGINS": "https://tutorlage.com,https://darkphillipino.github.io",
    // Cloudflare sets this header to the visitor's address; see rateLimit() in server/index.ts.
    "RATE_LIMIT_IP_HEADER": "cf-connecting-ip",
    // Video rooms (master 7bm), switched on 16 Oct 2026 (the CEO's "all seven, video rooms first"). Both are needed: without
    // VIDEO_RELAY_ONLY every room route answers 503 (fails closed). The relay's two secrets (CF_TURN_KEY_ID, CF_TURN_API_TOKEN)
    // are saved as Worker secrets. The database part is migration 20261009200000 (applied to dev 16 Oct).
    "VIDEO_ROOMS_ENABLED": "1",
    "VIDEO_RELAY_ONLY": "1"
  },
  "observability": { "enabled": true }
}
