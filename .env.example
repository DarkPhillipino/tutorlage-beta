# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (frontend, src/lib/supabaseClient.ts) ---
# VITE_ prefix required so Vite exposes these to browser code. Safe to expose:
# access is enforced by Row Level Security policies on every table, not by key secrecy.
VITE_SUPABASE_URL="https://wfpjoxetbprmllqqarwp.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_uYCOWKWJoWh4hlXH22H_cQ_gKHZ5n3l"

# --- Supabase (backend only, server/index.ts) ---
# Service role key BYPASSES Row Level Security entirely. Server-side only,
# never prefix with VITE_, never expose to the browser. Get it from
# Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
# Optional on a host: the server falls back to VITE_SUPABASE_URL when unset.
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# --- Paystack (backend only, server/) ---
# Get these from the Paystack Dashboard > Settings > API Keys & Webhooks.
# Secret key server-side only, never prefix with VITE_, never expose to the browser.
PAYSTACK_SECRET_KEY="MY_PAYSTACK_SECRET_KEY"
PAYSTACK_PUBLIC_KEY="MY_PAYSTACK_PUBLIC_KEY"

# --- API server (server/index.ts) ---
PORT=8787
# Comma-separated real frontend origins allowed to call the API and to be a
# Paystack callback target. Defaults to http://localhost:3000 when unset.
# ALLOWED_ORIGINS="https://your-frontend.example"
# Set on a host that sits behind a proxy (e.g. 1), so rate limiting sees real client IPs.
# TRUST_PROXY=1
# Tutor bank-account validation (backlog 7a). Live Paystack keys always enforce it. With test keys it
# defaults to recording the result without blocking (Paystack's test mode refutes every made-up
# account); set to "enforce" to try the refusal path in test mode.
# BANK_VALIDATION=enforce
# Paystack webhook (7a/7z): once the server is deployed, set
#   https://<server address>/api/paystack/webhook
# as the webhook URL in Paystack Dashboard > Settings > API Keys & Webhooks. It's signed with
# PAYSTACK_SECRET_KEY; no extra secret is needed.

# --- Frontend build for production (master backlog item 1) ---
# GitHub Pages has no /api of its own. Set this to the deployed server's address when building for
# production (e.g. in the Pages workflow). Leave it unset in development: Vite forwards /api locally.
# VITE_API_BASE_URL="https://your-server.example"
